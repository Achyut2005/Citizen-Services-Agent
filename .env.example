# Citizen Services Agent - Environment Variables
# Copy this file to .env and fill in your keys

# Google Gemini API Key (Required for agent knowledge Q&A and form guidance)
GEMINI_API_KEY=your_gemini_api_key_here

# Sarvam AI API Key (Optional for enhanced Indic language text-to-speech / translation)
SARVAM_API_KEY=your_sarvam_api_key_here

# SQLite Database URL
DATABASE_URL="file:./dev.db"
